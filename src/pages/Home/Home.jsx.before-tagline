function Calc() {
  const [l, setL] = useState(12)
  const [w, setW] = useState(14)
  const [t, setT] = useState(0)

  const cov = CALC_TILES[t][1]
  const price = CALC_TILES[t][2]
  const area = l * w
  const boxes = Math.ceil((area * 1.1) / cov)
  const sub = boxes * price
  const extra = Math.round(sub * 0.06)
  const gst = Math.round((sub + extra) * 0.18)
  const total = sub + extra + gst

  const mv = useMotionValue(0)
  const shown = useTransform(
    mv,
    v => '₹ ' + Math.round(v).toLocaleString('en-IN')
  )

  useEffect(() => {
    const c = animate(mv, total, {
      duration: 0.6,
      ease: 'easeOut'
    })
    return () => c.stop()
  }, [total])

  const fmt = n => '₹ ' + n.toLocaleString('en-IN')
  const grid = Array.from({ length: Math.min(boxes, 60) })

  return (
    <div className="alt">
      <section className="sec calc">
        <Reveal>
          <span className="eyebrow left">TRY IT YOURSELF</span>
          <h2>
            Build a quote <span className="gt">in 5 seconds</span>
          </h2>
          <p className="lead2">
            Move the sliders and pick a tile. Boxes, extras, GST and total
            update live, just like in the app.
          </p>

          <div className="slid">
            <label>
              <span>Length</span>
              <b>{l} ft</b>
            </label>
            <input
              type="range"
              min="8"
              max="30"
              value={l}
              onChange={e => setL(+e.target.value)}
            />
          </div>

          <div className="slid">
            <label>
              <span>Width</span>
              <b>{w} ft</b>
            </label>
            <input
              type="range"
              min="8"
              max="30"
              value={w}
              onChange={e => setW(+e.target.value)}
            />
          </div>

          <div className="tsel">
            {CALC_TILES.map(([n], i) => (
              <button
                key={n}
                type="button"
                className={t === i ? 'on' : ''}
                onClick={() => setT(i)}
              >
                {t === i && (
                  <motion.span layoutId="tsel" className="tsel-bg" />
                )}
                <span>{n}</span>
              </button>
            ))}
          </div>
        </Reveal>

        <Reveal delay={0.15}>
          <Tilt className="qc">
            <div className="qc-top">
              <b>Live quote</b>
              <em>{area} sq ft</em>
            </div>

            <div className="floor">
              {grid.map((_, i) => (
                <motion.span
                  key={i}
                  initial={{ scale: 0 }}
                  animate={{ scale: 1 }}
                  transition={{
                    delay: i * 0.012,
                    type: 'spring',
                    stiffness: 300,
                    damping: 18
                  }}
                  style={{
                    background: ['#0F3D3E', '#2A9D8F', '#E9B44C', '#D9622B'][i % 4]
                  }}
                />
              ))}
            </div>

            <p className="qc-r">
              <span>Boxes (10% extra for cutting)</span>
              <b>{boxes}</b>
            </p>

            <p className="qc-r">
              <span>Tiles</span>
              <b>{fmt(sub)}</b>
            </p>

            <p className="qc-r">
              <span>Adhesive and grout</span>
              <b>{fmt(extra)}</b>
            </p>

            <p className="qc-r">
              <span>GST 18%</span>
              <b>{fmt(gst)}</b>
            </p>

            <div className="qc-total">
              <span>Quote total</span>
              <motion.b>{shown}</motion.b>
            </div>
          </Tilt>
        </Reveal>
      </section>
    </div>
  )
}

