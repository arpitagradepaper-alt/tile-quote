.pg{position:relative;overflow:hidden;margin-top:60px;padding:100px 5vw;color:#fff;transition:background-color 1.2s}
.pg.bad{background-color:#2b1410}
.pg.ok{background-color:#0A2B2C}
.pg::before,.pg::after{content:'';position:absolute;inset:0;pointer-events:none;transition:opacity 1.2s}
.pg::before{background:radial-gradient(circle at 15% 0%,rgba(217,98,43,.35),transparent 55%)}
.pg::after{background:radial-gradient(circle at 85% 0%,rgba(42,157,143,.4),transparent 55%);opacity:0}
.pg.ok::before{opacity:0}
.pg.ok::after{opacity:1}
.pg-in{position:relative;z-index:1;max-width:1100px;margin:0 auto}
.pg-top{text-align:center;margin-bottom:36px}
.pg h2{font-size:clamp(28px,4vw,46px);letter-spacing:-.01em;min-height:1.2em}
.pg .sub{color:#c4d6d2;margin:12px 0 22px}
.pg-cur{display:inline-block;width:3px;height:.9em;margin-left:4px;vertical-align:-.1em;background:var(--y);animation:pgcur 1s steps(1) infinite}
@keyframes pgcur{50%{opacity:0}}
.pg-prog{max-width:320px;margin:0 auto;font-size:13px;color:#c4d6d2}
.pg-bar{height:6px;margin-top:8px;border-radius:6px;overflow:hidden;background:rgba(255,255,255,.12)}
.pg-bar i{display:block;height:100%;width:0;border-radius:6px;background:linear-gradient(90deg,var(--o),var(--y),var(--teal))}
.pg-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}
.pg-card{position:relative;padding:26px;border-radius:22px;cursor:pointer;border:1.5px solid rgba(255,110,80,.55);background:rgba(255,255,255,.05);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);transition:border-color .5s,background .5s,box-shadow .3s}
.pg-card.ok{border-color:rgba(42,157,143,.9);background:rgba(42,157,143,.14)}
.pg-card.over{box-shadow:0 0 0 3px var(--y),0 0 40px rgba(233,180,76,.45)}
.pg-card.bad .pg-j{animation:pgjit 2.2s infinite}
@keyframes pgjit{0%,88%,100%{transform:translate(0)}90%{transform:translate(-3px,1px)}92%{transform:translate(3px,-1px)}94%{transform:translate(-2px,0)}96%{transform:translate(2px,1px)}}
.pg-ic{display:grid;place-items:center;width:54px;height:54px;margin-bottom:16px;border-radius:16px;color:#ff8a63;background:rgba(255,110,80,.14);transition:all .5s}
.pg-card.ok .pg-ic{color:#fff;background:linear-gradient(135deg,var(--teal),var(--deep))}
.pg-ic svg{width:28px;height:28px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.pg-card h3{font-size:19px;margin-bottom:8px}
.pg-card p{min-height:72px;line-height:1.6;font-size:15px}
.pg-b{color:#ffb7a3;text-shadow:1px 0 rgba(255,60,60,.5),-1px 0 rgba(0,220,255,.35)}
.pg-f{color:#bdf0e8}
.pg-tag{display:inline-block;margin-top:10px;padding:4px 12px;border-radius:99px;font-size:12px;font-weight:700;background:rgba(255,110,80,.2);color:#ffb7a3}
.pg-card.ok .pg-tag{background:rgba(42,157,143,.3);color:#bdf0e8}
.pg-burst{position:absolute;left:50%;top:50%;width:0;height:0;pointer-events:none;z-index:3}
.pg-burst i{position:absolute;left:-5px;top:-5px;width:10px;height:10px;border-radius:3px}
.pg-rip{position:absolute;left:-60px;top:-60px;width:120px;height:120px;border-radius:50%;border:3px solid var(--y)}
.pg-foot{display:flex;align-items:center;justify-content:center;gap:18px;flex-wrap:wrap;min-height:56px;margin-top:34px}
.pg-chip{position:relative;z-index:5;display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:99px;cursor:grab;touch-action:none;user-select:none;font-family:Sora,sans-serif;font-weight:700;color:#fff;background:linear-gradient(120deg,var(--teal),var(--o));box-shadow:0 10px 30px rgba(217,98,43,.45)}
.pg-hint{font-size:14px;color:#c4d6d2}
.pg-reset{padding:12px 22px;border:1.5px solid rgba(255,255,255,.4);border-radius:99px;background:none;color:#fff;font:inherit;cursor:pointer}
/* Make the page background dark so the gap disappears */
html, body {
  background: #0b2b2b; /* match your dark green */
}

/* Remove any spacing between the two sections */
section {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}